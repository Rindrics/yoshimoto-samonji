{
  "name": "yoshimoto-samonji",
  "version": "0.1.0",
  "description": "Yoshimoto Samonji API",
  "scripts": {
    "prepare": "husky install",
    "docs:install": "python3 -m pip install -r requirements.txt",
    "docs:build": "zensical build",
    "docs:serve": "zensical serve"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11"
  },
  "lint-staged": {
    "services/monolith/**/*.R": [
      "sh -c 'LINTR_ERROR_ON_LINT=true make -C services/monolith lint'"
    ]
  }
}
